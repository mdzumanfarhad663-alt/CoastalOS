{
	"$schema": "https://schemas.wp.org/wp/6.9/block.json",
	"apiVersion": 3,
	"name": "coastalos/opportunity",
	"version": "1.0.0",
	"title": "Opportunity toggle diagram",
	"category": "coastalos-sections",
	"icon": "chart-area",
	"description": "An editable CoastalOS opportunity toggle diagram section.",
	"textdomain": "coastalos-blocks",
	"attributes": {
		"background": {
			"enum": [
				"light",
				"white",
				"navy"
			],
			"default": "white",
			"type": "string"
		},
		"spacing": {
			"enum": [
				"normal",
				"compact"
			],
			"default": "normal",
			"type": "string"
		},
		"hideOnPage": {
			"default": false,
			"type": "boolean"
		},
		"prototypePage": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"spacing": {
			"padding": false,
			"blockGap": false,
			"margin": false
		},
		"typography": {
			"fontSize": false,
			"lineHeight": false
		},
		"customClassName": false,
		"color": {
			"text": false,
			"background": false
		},
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false
	},
	"editorScript": "file:../../build/index.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js"
}
