{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "CoastalOS",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px",
      "allowCustomContentAndWideSize": false
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        { "name": "Navy", "slug": "navy", "color": "#0E2A47" },
        { "name": "Deep navy", "slug": "navy-deep", "color": "#0A2038" },
        { "name": "Navy light", "slug": "navy-light", "color": "#163A5E" },
        { "name": "Teal", "slug": "teal", "color": "#1C8C8A" },
        { "name": "Teal ink", "slug": "teal-ink", "color": "#167573" },
        { "name": "Teal light", "slug": "teal-light", "color": "#6FD0CC" },
        { "name": "Teal soft", "slug": "teal-soft", "color": "#E6F3F2" },
        { "name": "Sun", "slug": "sun", "color": "#C9932F" },
        { "name": "Sun soft", "slug": "sun-soft", "color": "#F6EBD5" },
        { "name": "Page", "slug": "page", "color": "#F6F9FA" },
        { "name": "Paper", "slug": "paper", "color": "#FFFFFF" },
        { "name": "Ink", "slug": "ink", "color": "#132235" },
        { "name": "Muted", "slug": "muted", "color": "#4F6175" },
        { "name": "Line", "slug": "line", "color": "#DCE5EA" },
        { "name": "Skeleton", "slug": "skeleton", "color": "#E9EFF2" }
      ]
    },
    "border": {
      "radius": true,
      "radiusSizes": [
        { "name": "Small", "slug": "small", "size": "10px" },
        { "name": "Medium", "slug": "medium", "size": "16px" },
        { "name": "Large", "slug": "large", "size": "24px" },
        { "name": "Pill", "slug": "pill", "size": "999px" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Outfit",
          "slug": "display",
          "fontFamily": "\"Outfit\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Outfit",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/outfit-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Outfit",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/outfit-latin-ext.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        },
        {
          "name": "Instrument Sans",
          "slug": "body",
          "fontFamily": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Sans",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/instrument-sans-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Instrument Sans",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/instrument-sans-latin-ext.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        }
      ],
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "0.9rem" },
        { "name": "Base", "slug": "base", "size": "1.0625rem" },
        { "name": "Large", "slug": "large", "size": "1.2rem" },
        { "name": "Heading 3", "slug": "heading-3", "size": "1.5rem" },
        { "name": "Heading 2", "slug": "heading-2", "size": "clamp(1.9rem, 3.6vw, 2.85rem)" },
        { "name": "Heading 1", "slug": "heading-1", "size": "clamp(2.3rem, 3.6vw, 3.25rem)" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": false,
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "name": "2 XS", "slug": "2-xs", "size": "0.25rem" },
        { "name": "XS", "slug": "xs", "size": "0.5rem" },
        { "name": "Small", "slug": "sm", "size": "0.75rem" },
        { "name": "Medium", "slug": "md", "size": "1rem" },
        { "name": "Large", "slug": "lg", "size": "1.5rem" },
        { "name": "XL", "slug": "xl", "size": "2rem" },
        { "name": "2 XL", "slug": "2-xl", "size": "3rem" },
        { "name": "3 XL", "slug": "3-xl", "size": "4rem" },
        { "name": "4 XL", "slug": "4-xl", "size": "6rem" }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "name": "Coastal", "slug": "coastal", "shadow": "0 1px 2px rgba(14,42,71,.04), 0 12px 32px -18px rgba(14,42,71,.28)" },
        { "name": "Coastal large", "slug": "coastal-large", "shadow": "0 2px 4px rgba(14,42,71,.05), 0 32px 64px -32px rgba(14,42,71,.45)" }
      ]
    },
    "custom": {
      "contentWidth": "1200px",
      "wideWidth": "1440px",
      "gap": "clamp(16px, 2.4vw, 24px)",
      "sectionSpace": "clamp(80px, 9vw, 128px)",
      "ease": "cubic-bezier(.2, .7, .2, 1)",
      "radius": {
        "sm": "10px",
        "md": "16px",
        "lg": "24px",
        "pill": "999px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|page",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|base",
      "fontWeight": "400",
      "lineHeight": "1.65",
      "textTransform": "none"
    },
    "elements": {
      "heading": {
        "color": { "text": "var:preset|color|navy" },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-0.022em"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|teal-ink" }
      },
      "button": {
        "color": { "background": "var:preset|color|navy", "text": "#FFFFFF" },
        "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600" },
        "border": { "radius": "var(--wp--custom--radius--pill)" }
      }
    },
    "blocks": {
      "core/post-content": {
        "spacing": { "blockGap": "0" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
